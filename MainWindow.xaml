<Window x:Class="SPPS2001D_Pro.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SPPS2001D Pro — 6-Digit Protocol" Height="640" Width="900" Background="#121212">
  <Window.Resources>
    <Style x:Key="DarkButton" TargetType="Button"><Setter Property="Background" Value="#222831"/><Setter Property="Foreground" Value="#EDEDED"/><Setter Property="BorderBrush" Value="#4B5563"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="OutputOnButton" TargetType="Button" BasedOn="{StaticResource DarkButton}"><Style.Triggers><DataTrigger Binding="{Binding IsOutputOn}" Value="True"><Setter Property="Background" Value="#DC2626"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#FCA5A5"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="DarkTextBox" TargetType="TextBox"><Setter Property="Background" Value="#0B0F14"/><Setter Property="Foreground" Value="#EDEDED"/><Setter Property="BorderBrush" Value="#4B5563"/><Setter Property="CaretBrush" Value="#00D7FF"/><Setter Property="Padding" Value="6,3"/></Style>
    <Style x:Key="DarkComboBoxItem" TargetType="{x:Type ComboBoxItem}"><Setter Property="Background" Value="#111827"/><Setter Property="Foreground" Value="#F9FAFB"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#181C22" BorderBrush="#333A45" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="COM:" Foreground="#EDEDED" VerticalAlignment="Center"/><ComboBox x:Name="ComPortsCombo" Width="150" Margin="6,0,0,0" ItemsSource="{Binding Serial.Ports}" SelectedItem="{Binding Serial.SelectedPort}" DisplayMemberPath="DisplayName" DropDownOpened="ComPortsCombo_DropDownOpened"/><ComboBox Width="95" Margin="10,0,0,0" ItemsSource="{Binding Serial.BaudRates}" SelectedItem="{Binding Serial.SelectedBaud}"/><Button Style="{StaticResource DarkButton}" Width="115" Content="{Binding SerialConnectText}" Command="{Binding ToggleConnectCommand}"/><Button Style="{StaticResource DarkButton}" Width="110" Content="Remote" Command="{Binding RemoteModeCommand}"/><Button Style="{StaticResource DarkButton}" Width="90" Content="Local" Command="{Binding LocalModeCommand}"/><Border Margin="14,0,0,0" Padding="8,3" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding StatusBrush}"><TextBlock Text="{Binding Serial.Status}" Foreground="{Binding StatusBrush}" FontWeight="Bold"/></Border><CheckBox Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#EDEDED" Content="CSV Log" IsChecked="{Binding LoggingEnabled}"/>
    </StackPanel></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#181C22" BorderBrush="#333A45" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0"><StackPanel><TextBlock Text="Setpoints" Foreground="#EDEDED" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="Voltage (V)" Foreground="#7BE8FF" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,4,0,12"><TextBox Style="{StaticResource DarkTextBox}" Width="125" Text="{Binding Vset}" TextChanged="TextBox_TextChanged"/><Button Style="{StaticResource DarkButton}" Width="80" Content="Set V" Command="{Binding SetVCommand}"/></StackPanel><TextBlock Text="Current (A)" Foreground="#5AAEFF" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,4,0,16"><TextBox Style="{StaticResource DarkTextBox}" Width="125" Text="{Binding Iset}"/><Button Style="{StaticResource DarkButton}" Width="80" Content="Set I" Command="{Binding SetICommand}"/></StackPanel><Separator Margin="0,6,0,12" Background="#333A45"/><Button Style="{StaticResource OutputOnButton}" Content="Output ON" Height="34" Command="{Binding OutputOnCommand}"/><Button Style="{StaticResource DarkButton}" Content="Output OFF" Height="34" Command="{Binding OutputOffCommand}"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#050607" BorderBrush="#2F343B" BorderThickness="3" CornerRadius="18" Padding="18"><Border Background="#0B0D10" BorderBrush="#151A20" BorderThickness="2" CornerRadius="8" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayModeLabel}" Foreground="{Binding ModeBrush}" FontFamily="Consolas" FontSize="34" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VoltageDisplay}" Foreground="#36DFFF" FontFamily="Consolas" FontSize="76" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/><TextBlock Grid.Row="0" Grid.Column="2" Text="V" Foreground="#8EEFFF" FontFamily="Consolas" FontSize="42" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentDisplay}" Foreground="#208CFF" FontFamily="Consolas" FontSize="76" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/><TextBlock Grid.Row="1" Grid.Column="2" Text="A" Foreground="#3A9DFF" FontFamily="Consolas" FontSize="42" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PowerDisplay}" Foreground="#A569FF" FontFamily="Consolas" FontSize="76" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/><TextBlock Grid.Row="2" Grid.Column="2" Text="W" Foreground="#B77AFF" FontFamily="Consolas" FontSize="42" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Border></Border>
    </Grid>
    <Border Grid.Row="2" Margin="0,12,0,0" Background="#181C22" BorderBrush="#333A45" BorderThickness="1" CornerRadius="8" Padding="8"><TextBox Text="{Binding Log}" Background="#0B0F14" Foreground="#D7D7D7" BorderThickness="0" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="88"/></Border>
  </Grid>
</Window>
